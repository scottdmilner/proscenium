#usda 1.0
(
    """The node definitions: one class prim per node type, named for the type, which is also the type name of that
    node's prims in a tree (docs/phase3/node-tree.md "Node definitions"). The cook loads it through Sdf, never
    registers it with USD, and checks that each definition has an implementation in tree_cook/nodes/node_registry.cpp,
    and the reverse; tools/node_attributes.py writes each type's attribute header from it.

    A class prim holds `int node:version` and `doc`, and an attribute per input (inputs:), output (outputs:), and
    property (props:), with its type and default. Menus are allowedTokens. Each attribute's customData holds what USD's
    types can't:
    - socket: "Layer", "EditableLayer", "File", "Prim", or "Prims"; a value socket or property has none, and its type
      is its USD value type. Layer and EditableLayer sockets are opaque; File, Prim, and Prims are strings.
    - multiInput: true for a Layer input that takes several links, in connection order.
    - optional: true for a property that is unauthored unless set, which a node reads as an AuthoredField.
    - dynamicType: true for a value whose type follows another property, which a node reads as a VtValue.
    - mutePassThrough, on an output: the input whose value a muted node passes through it.

    A Path property is a string, as typed: `//` starts a path relative to the base directory, and any other path goes
    to USD's resolver as written (docs/phase3/node-tree.md "The tree as plain data")."""
)

class "LayerFromFile" (
    doc = "Reads a layer: the process's shared copy of the file at Path, which it never authors into."
)
{
    int node:version = 1
    string props:path = "" (
        doc = "The file to read, `//` relative to the .blend."
    )
    opaque outputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
}

class "StageOutput" (
    doc = """Names one of the tree's stages: the stage composed on its input Layer, with every payload loaded, which
    a binding displays."""
)
{
    int node:version = 1
    opaque inputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
    bool props:coordinateConversion = 0 (
        doc = """The binding's units and up-axis conversion, off by default, which the front end reads; the cook
        doesn't convert."""
    )
}

class "Viewer" (
    doc = """Names the stage the editor's UI shows: the stage composed on its input Layer, with every payload loaded,
    which feeds no binding and isn't converted."""
)
{
    int node:version = 1
    opaque inputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
    bool props:context = 1 (
        doc = """Composes a New Layer Zone's layer over the zone's context; any other layer has none, and is
        composed alone."""
    )
}
