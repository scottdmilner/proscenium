#usda 1.0
# Purpose: compiled Hydra bridge stage exchange, time, inheritance and instancing.
def Xform "World"
{
    double3 xformOp:translate = (10, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    def Mesh "Tri"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        point3f[] points.timeSamples = {
            1: [(0, 0, 0), (1, 0, 0), (0, 1, 0)],
            3: [(0, 0, 0), (3, 0, 0), (0, 3, 0)],
        }
        uniform token subdivisionScheme = "none"
    }
    def Cube "Cube"
    {
        double size = 2
    }
}
def Xform "Asset"
{
    def Mesh "Part"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}
def Xform "InstanceA" (
    instanceable = true
    prepend references = </Asset>
) {}
def Xform "InstanceB" (
    instanceable = true
    prepend references = </Asset>
) {}
