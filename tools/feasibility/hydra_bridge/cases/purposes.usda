#usda 1.0
(
    upAxis = "Z"
)
# Purpose: M1b Phase C, prim purposes and material purposes together, for the two destinations in
# spec/support/visibility.md: the viewport shows default and proxy prims (and guides USD makes explicitly
# visible), the final render default and render prims. The bridge resolves preview materials for the
# viewport and full ones for the render, by default. Each mesh is one triangle, or two for Split:
# - Both (default purpose) binds Preview for preview and Full for full, so it shows in both with different
#   materials: two objects sharing one mesh.
# - Same (default) binds Shared for all purposes: one object for both destinations.
# - Split (default) has two materialBind subsets; preview binds both to Preview, full binds them to Full
#   and Shared, so the destinations group its faces differently.
# - Proxy and Render show in one destination each, with that destination's material. Proxy also binds
#   Unseen for full, which nothing displays, so the plan must not include it.
# - Guide is invisible by the guide fallback; ShownGuide is made visible and shows in the viewport.
#   InheritedGuide authors guideVisibility = "inherited" with no ancestor opinion, which UsdGeom reports as
#   "inherited", not "visible": not explicitly visible, so in neither destination (VIS-04).
# - HiddenRender is a render prim under renderVisibility = invisible: in neither destination.
# - Kit, a native instance, holds a default, a proxy and a render prim with purpose-specific bindings.

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "Preview"
        {
        }

        def Material "Full"
        {
        }

        def Material "Shared"
        {
        }

        def Material "Unseen"
        {
        }
    }

    def Mesh "Both" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding:preview = </World/Looks/Preview>
        rel material:binding:full = </World/Looks/Full>
    }

    def Mesh "Same" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/Looks/Shared>
    }

    def Mesh "Split"
    {
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 1, 3, 2]
        point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0), (5, 1, 0)]
        uniform token subdivisionScheme = "none"

        def GeomSubset "First" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [0]
            rel material:binding:preview = </World/Looks/Preview>
            rel material:binding:full = </World/Looks/Full>
        }

        def GeomSubset "Second" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token elementType = "face"
            uniform token familyName = "materialBind"
            int[] indices = [1]
            rel material:binding:preview = </World/Looks/Preview>
            rel material:binding:full = </World/Looks/Shared>
        }
    }

    def Mesh "Proxy" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 2, 0), (1, 2, 0), (0, 3, 0)]
        uniform token subdivisionScheme = "none"
        uniform token purpose = "proxy"
        rel material:binding:preview = </World/Looks/Preview>
        rel material:binding:full = </World/Looks/Unseen>
    }

    def Mesh "Render" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(2, 2, 0), (3, 2, 0), (2, 3, 0)]
        uniform token subdivisionScheme = "none"
        uniform token purpose = "render"
        rel material:binding:full = </World/Looks/Full>
    }

    def Mesh "Guide"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(4, 2, 0), (5, 2, 0), (4, 3, 0)]
        uniform token subdivisionScheme = "none"
        uniform token purpose = "guide"
    }

    def Mesh "ShownGuide" (
        prepend apiSchemas = ["VisibilityAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(6, 2, 0), (7, 2, 0), (6, 3, 0)]
        uniform token subdivisionScheme = "none"
        uniform token purpose = "guide"
        uniform token guideVisibility = "visible"
    }

    def Mesh "InheritedGuide" (
        prepend apiSchemas = ["VisibilityAPI"]
    )
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(8, 2, 0), (9, 2, 0), (8, 3, 0)]
        uniform token subdivisionScheme = "none"
        uniform token purpose = "guide"
        uniform token guideVisibility = "inherited"
    }

    def Xform "Muted" (
        prepend apiSchemas = ["VisibilityAPI"]
    )
    {
        uniform token renderVisibility = "invisible"

        def Mesh "HiddenRender"
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 4, 0), (1, 4, 0), (0, 5, 0)]
            uniform token subdivisionScheme = "none"
            uniform token purpose = "render"
        }
    }

    def Xform "Kit" (
        instanceable = true
        prepend references = </Assets/Kit>
    )
    {
        double3 xformOp:translate = (0, 6, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

# Abstract, so only its reference is drawn.
class Xform "Assets"
{
    def Xform "Kit"
    {
        def Scope "Looks"
        {
            def Material "Sketch"
            {
            }

            def Material "Final"
            {
            }
        }

        def Mesh "Body" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            uniform token subdivisionScheme = "none"
            rel material:binding:preview = </Assets/Kit/Looks/Sketch>
            rel material:binding:full = </Assets/Kit/Looks/Final>
        }

        def Mesh "Stand" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(2, 0, 0), (3, 0, 0), (2, 1, 0)]
            uniform token subdivisionScheme = "none"
            uniform token purpose = "proxy"
            rel material:binding:preview = </Assets/Kit/Looks/Sketch>
        }

        def Mesh "Detail" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(4, 0, 0), (5, 0, 0), (4, 1, 0)]
            uniform token subdivisionScheme = "none"
            uniform token purpose = "render"
            rel material:binding:full = </Assets/Kit/Looks/Final>
        }
    }
}
