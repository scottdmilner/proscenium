#usda 1.0
# Bolt asset of the production-like CI fixture (tests/fixtures/production_like.py). Two meshes
# with two materials. The crate asset uses it four times as an instanceable reference, so
# instancing nests: bolt instances inside the crate prototype. Its kind is subcomponent because
# it only appears inside the crate component; a component inside a component breaks the model
# hierarchy.
(
    defaultPrim = "Bolt"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Bolt" (
    assetInfo = {
        string name = "bolt"
    }
    kind = "subcomponent"
)
{
    def Mesh "Shaft" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.05, -0.05, 0), (0.05, 0.05, 0.4)]
        int[] faceVertexCounts = [4, 4, 4, 4]
        int[] faceVertexIndices = [0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7]
        point3f[] points = [(-0.05, -0.05, 0), (0.05, -0.05, 0), (0.05, 0.05, 0), (-0.05, 0.05, 0), (-0.05, -0.05, 0.4), (0.05, -0.05, 0.4), (0.05, 0.05, 0.4), (-0.05, 0.05, 0.4)]
        rel material:binding = </Bolt/Looks/Steel>
    }

    def Mesh "Head" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.1, -0.1, 0.4), (0.1, 0.1, 0.5)]
        int[] faceVertexCounts = [4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7]
        point3f[] points = [(-0.1, -0.1, 0.4), (0.1, -0.1, 0.4), (0.1, 0.1, 0.4), (-0.1, 0.1, 0.4), (-0.1, -0.1, 0.5), (0.1, -0.1, 0.5), (0.1, 0.1, 0.5), (-0.1, 0.1, 0.5)]
        rel material:binding = </Bolt/Looks/Brass>
    }

    def Scope "Looks"
    {
        def Material "Steel"
        {
            token outputs:surface.connect = </Bolt/Looks/Steel/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.6, 0.6, 0.65)
                float inputs:metallic = 1
                token outputs:surface
            }
        }

        def Material "Brass"
        {
            token outputs:surface.connect = </Bolt/Looks/Brass/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.6, 0.2)
                float inputs:metallic = 1
                token outputs:surface
            }
        }
    }
}
