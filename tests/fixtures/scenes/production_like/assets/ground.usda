#usda 1.0
# Ground plane of the production-like CI fixture (tests/fixtures/production_like.py). Referenced
# directly, not through a payload, so a load-no-payload stage still has a mesh to display.
(
    defaultPrim = "Ground"
    metersPerUnit = 1
    upAxis = "Z"
)

def Mesh "Ground"
{
    float3[] extent = [(-50, -50, 0), (50, 50, 0)]
    int[] faceVertexCounts = [4]
    int[] faceVertexIndices = [0, 1, 2, 3]
    point3f[] points = [(-50, -50, 0), (50, -50, 0), (50, 50, 0), (-50, 50, 0)]
}
