#usda 1.0
# The scene graph's nested instances (tests/bpy_free/test_prim_tree.py, tests/blender/test_scene_graph.py): an
# instance, /World/Pallet, whose prototype holds another, Crate, so Crate is an instance proxy and an instance, and its
# Lid is a proxy under both.
(
    defaultPrim = "World"
)

class "_Crate"
{
    def Xform "Lid"
    {
    }
}

class "_Pallet"
{
    def Xform "Crate" (
        instanceable = true
        references = </_Crate>
    )
    {
    }
}

def Xform "World"
{
    def Xform "Pallet" (
        instanceable = true
        references = </_Pallet>
    )
    {
    }
}
