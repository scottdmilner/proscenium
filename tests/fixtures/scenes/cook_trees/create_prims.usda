#usda 1.0
# Create Prim (docs/phase3/node-tree.md "Create Prim"). Zone's chain authors World, a def Xform at the root; Chair, a
# def Mesh under World's Prim; Lamp, under Room's /Set/Room, whose ancestors the layer lacks, so each is an over; Base,
# a class; Over, an over; and Set, a def Xform at /Set, which takes the over Lamp authored for it. Its end's Default
# Prim is World's Prim. Annex's Extra is under Chair's Prim, from Zone, though Annex's task runs first, since its ID
# sorts first and no Layer link orders the two.

def NodeTree "Tree"
{
    int tree:format = 1

    def Prim "Room"
    {
        int node:version = 1
        string props:path = "/Set/Room"
        string outputs:prim
    }

    def NewLayerZoneBegin "Zone"
    {
        int node:version = 1
        opaque outputs:layer
        rel zone:end = </Tree/ZoneEnd>
    }

    def CreatePrim "World"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Zone.outputs:layer>
        string inputs:name = "World"
        token props:type = "Xform"
        opaque outputs:editableLayer
    }

    def CreatePrim "Chair"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/World.outputs:editableLayer>
        string inputs:parent.connect = </Tree/World.outputs:prim>
        string inputs:name = "Chair"
        token props:type = "Mesh"
        string outputs:prim
        opaque outputs:editableLayer
    }

    def CreatePrim "Lamp"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Chair.outputs:editableLayer>
        string inputs:parent.connect = </Tree/Room.outputs:prim>
        string inputs:name = "Lamp"
        opaque outputs:editableLayer
    }

    def CreatePrim "Base"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Lamp.outputs:editableLayer>
        string inputs:name = "Base"
        token props:specifier = "class"
        opaque outputs:editableLayer
    }

    def CreatePrim "Over"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Base.outputs:editableLayer>
        string inputs:name = "Over"
        token props:specifier = "over"
        opaque outputs:editableLayer
    }

    def CreatePrim "Set"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Over.outputs:editableLayer>
        string inputs:name = "Set"
        token props:type = "Xform"
        opaque outputs:editableLayer
    }

    def NewLayerZoneEnd "ZoneEnd"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Set.outputs:editableLayer>
        string inputs:defaultPrim.connect = </Tree/World.outputs:prim>
        opaque outputs:layer
    }

    def StageOutput "Out"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/ZoneEnd.outputs:layer>
    }

    def NewLayerZoneBegin "Annex"
    {
        int node:version = 1
        opaque outputs:layer
        rel zone:end = </Tree/AnnexEnd>
    }

    def CreatePrim "Extra"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Annex.outputs:layer>
        string inputs:parent.connect = </Tree/Chair.outputs:prim>
        string inputs:name = "Extra"
        opaque outputs:editableLayer
    }

    def NewLayerZoneEnd "AnnexEnd"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Extra.outputs:editableLayer>
        opaque outputs:layer
    }

    def StageOutput "AnnexOut"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/AnnexEnd.outputs:layer>
    }
}
