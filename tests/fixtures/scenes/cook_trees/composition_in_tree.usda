#usda 1.0
# A tree whose layer has a sublayer and a node prim with a reference: two composition-in-tree errors, one at the
# layer's root and one at the node, which is still read (its own error is unknown-node-type: Scope is no node type).
(
    subLayers = [
        @./empty_tree.usda@
    ]
)

def NodeTree "Tree"
{
    int tree:format = 1

    def Scope "Referencing" (
        references = @./empty_tree.usda@</Tree>
    )
    {
    }
}
