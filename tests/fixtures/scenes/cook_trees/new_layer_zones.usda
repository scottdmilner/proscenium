#usda 1.0
# An empty New Layer Zone linked to a Stage Output and a Viewer (docs/phase3/node-tree.md "New Layer Zone"). Out sorts
# before Zone but waits for the zone's task, and shares the zone's anonymous layer with View. Spare is a zone that no
# Stage Output composes, which still cooks.

def NodeTree "Tree"
{
    int tree:format = 1

    def StageOutput "Out"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/ZoneEnd.outputs:layer>
    }

    def NewLayerZoneBegin "Spare"
    {
        int node:version = 1
        string inputs:file = "//spare.usda"
        opaque outputs:layer
        rel zone:end = </Tree/SpareEnd>
    }

    def NewLayerZoneEnd "SpareEnd"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Spare.outputs:layer>
        opaque outputs:layer
    }

    def Viewer "View"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/ZoneEnd.outputs:layer>
    }

    def NewLayerZoneBegin "Zone"
    {
        int node:version = 1
        string inputs:file = "//zone.usda"
        opaque outputs:layer
        rel zone:end = </Tree/ZoneEnd>
    }

    def NewLayerZoneEnd "ZoneEnd"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Zone.outputs:layer>
        opaque outputs:layer
    }
}
