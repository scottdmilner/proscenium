#usda 1.0
# A cycle of links, A to B and back, with C downstream of the cycle and D apart from it: A and B each get a cycle
# error, C and D don't. Each node's type is unknown before step 4, which is its other error.

def NodeTree "Tree"
{
    int tree:format = 1

    def Relay "A"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/B.outputs:layer>
        opaque outputs:layer
    }

    def Relay "B"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/A.outputs:layer>
        opaque outputs:layer
    }

    def Relay "C"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/B.outputs:layer>
        opaque outputs:layer
    }

    def Relay "D"
    {
        int node:version = 1
        opaque outputs:layer
    }
}
