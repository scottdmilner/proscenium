#usda 1.0
# Prim paths (docs/phase3/node-tree.md "Prim"). Relative isn't absolute, Property names a property, Variant a variant,
# Garbage isn't a path, and Empty names nothing; Root and Good are prim paths, the absolute root among them.
# PrimIntoLayer links Good's Prim into a Stage Output's Layer. Unanchored's Parent isn't absolute.

def NodeTree "Tree"
{
    int tree:format = 1

    def Prim "Relative"
    {
        int node:version = 1
        string props:path = "World"
        string outputs:prim
    }

    def Prim "Property"
    {
        int node:version = 1
        string props:path = "/World.size"
        string outputs:prim
    }

    def Prim "Variant"
    {
        int node:version = 1
        string props:path = "/World{look=red}Inner"
        string outputs:prim
    }

    def Prim "Garbage"
    {
        int node:version = 1
        string props:path = "/Wor ld"
        string outputs:prim
    }

    def Prim "Empty"
    {
        int node:version = 1
        string props:path = ""
        string outputs:prim
    }

    def Prim "Root"
    {
        int node:version = 1
        string props:path = "/"
        string outputs:prim
    }

    def Prim "Good"
    {
        int node:version = 1
        string props:path = "/World"
        string outputs:prim
    }

    def StageOutput "PrimIntoLayer"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Good.outputs:prim>
    }

    def NewLayerZoneBegin "Zone"
    {
        int node:version = 1
        opaque outputs:layer
        rel zone:end = </Tree/ZoneEnd>
    }

    def CreatePrim "Unanchored"
    {
        int node:version = 1
        opaque inputs:editableLayer.connect = </Tree/Zone.outputs:layer>
        string inputs:parent = "World"
        string inputs:name = "U"
        opaque outputs:editableLayer
    }

    def NewLayerZoneEnd "ZoneEnd"
    {
        int node:version = 1
        opaque inputs:layer.connect = </Tree/Unanchored.outputs:editableLayer>
        opaque outputs:layer
    }
}
