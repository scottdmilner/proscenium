#usda 1.0
# F-UNITS-UP-AXIS (tests/fixtures/evaluation.py): a Y-up stage in centimeters (metersPerUnit 0.01). This layer
# and units_z_up_m.usda hold the same prims and values, so only their stage metadata differs: Box, a mesh off
# the origin on every axis, and Kit, a native instance whose Body is translated inside the prototype, so
# conversion reaches geometry, transforms, bounds, and instances alike (CONV-03).
(
    defaultPrim = "World"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "World"
{
    def Mesh "Box" (
        references = </Shapes/Tetra>
    )
    {
        double3 xformOp:translate = (100, 20, 50)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Kit" (
        instanceable = true
        references = </Prototypes/Kit>
    )
    {
        double3 xformOp:translate = (0, 0, 200)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

class "Prototypes"
{
    def Xform "Kit"
    {
        def Mesh "Body" (
            references = </Shapes/Tetra>
        )
        {
            double3 xformOp:translate = (0, 100, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}

class "Shapes"
{
    def Mesh "Tetra"
    {
        float3[] extent = [(0, 0, 0), (10, 10, 10)]
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3]
        point3f[] points = [(0, 0, 0), (10, 0, 0), (0, 10, 0), (0, 0, 10)]
        uniform token subdivisionScheme = "none"
    }
}
