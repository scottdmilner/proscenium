#usda 1.0
# F-TRANSFORMS' payload (transforms.usda's Payloaded): one mesh, rotated 90 degrees about X inside the
# payload, so its world transform composes opinions from both sides of the arc. Load-none drops it.
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def Mesh "Geom"
    {
        float3[] extent = [(0, 0, 0), (1, 1, 1)]
        int[] faceVertexCounts = [3, 3, 3, 3]
        int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (0, 0, 1)]
        uniform token subdivisionScheme = "none"
        float xformOp:rotateX = 90
        uniform token[] xformOpOrder = ["xformOp:rotateX"]
    }
}
