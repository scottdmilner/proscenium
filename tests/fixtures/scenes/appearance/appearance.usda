#usda 1.0
# F-APPEARANCE-CASES (tests/fixtures/appearance.py): the representation feasibility cases of
# spec/support/geometry.md and spec/support/materials.md, one child of /World per case:
# - SharedPrototype: copies of a two-mesh, two-material prototype (PVAR-04, GRAM-06); Body authors
#   a display color its bound material must not show.
# - EqualContent: meshes outside instances, two with equal content, one differing only in a constant
#   displayColor, and one each only in its vertex st values, its subdivision scheme, and its sidedness
#   (PVAR-05).
# - NamedUVs: typed UV sets (st faceVarying and indexed, perfuv faceVarying, st vertex) and float2[]
#   primvars only UV-set names make UV sets of (ST, offset, and a constant uv_shift) (PVAR-06,
#   GEOM-13, GEOM-14), with a texture read through perfuv (GRAM-09).
# - MeshDisplayColor: unbound meshes with their own displayColor and displayOpacity at each
#   interpolation, one indexed (PVAR-07, GRAM-05).
# - InheritedColor: nested instances; inner and outer instance roots author display color, which
#   copies inherit unless nearer opinions win (PVAR-08).
# - InstancePrimvars: tint and rough on instance roots, read by primvar readers with fallbacks, and a
#   reader of displayColor (PVAR-09, GRAM-08).
# - MaterialPerInstance: one prototype whose instance roots bind different materials (GRAM-07).
# - FaceAssignments: materialBind subsets in a prototype, with unassigned faces taking each instance
#   root's binding, and a partition outside instances (PVAR-10, GRAM-10).
# - OneMaterial: Tinted bound to meshes of different geometry with different tints, and by the
#   InstancePrimvars copies (GRAM-11).
# - PurposeBindings: preview, full, and all-purpose bindings in combination (GRAM-12).
# Every mesh is visible with default purpose. Prototypes are abstract class prims.
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Scope "Looks"
    {
        def Material "Red"
        {
            token outputs:surface.connect = </World/Looks/Red/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.1, 0.1)
                float inputs:ior = 1.5
                float inputs:metallic = 0
                float inputs:opacity = 1
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }

        def Material "Blue"
        {
            token outputs:surface.connect = </World/Looks/Blue/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.1, 0.8)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Green"
        {
            token outputs:surface.connect = </World/Looks/Green/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.1, 0.8, 0.1)
                token outputs:surface
            }
        }

        def Material "Yellow"
        {
            token outputs:surface.connect = </World/Looks/Yellow/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.1)
                token outputs:surface
            }
        }

        def Material "Tinted"
        {
            token outputs:surface.connect = </World/Looks/Tinted/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Tinted/Tint.outputs:result>
                float inputs:roughness.connect = </World/Looks/Tinted/Rough.outputs:result>
                token outputs:surface
            }

            def Shader "Tint"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (0.5, 0.5, 0.5)
                string inputs:varname = "tint"
                float3 outputs:result
            }

            def Shader "Rough"
            {
                uniform token info:id = "UsdPrimvarReader_float"
                float inputs:fallback = 0.5
                string inputs:varname = "rough"
                float outputs:result
            }
        }

        def Material "DisplayTinted"
        {
            token outputs:surface.connect = </World/Looks/DisplayTinted/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/DisplayTinted/Color.outputs:result>
                token outputs:surface
            }

            def Shader "Color"
            {
                uniform token info:id = "UsdPrimvarReader_float3"
                float3 inputs:fallback = (1, 1, 1)
                string inputs:varname = "displayColor"
                float3 outputs:result
            }
        }

        def Material "Textured"
        {
            token outputs:surface.connect = </World/Looks/Textured/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/Textured/Texture.outputs:rgb>
                float inputs:roughness.connect = </World/Looks/Textured/Texture.outputs:r>
                token outputs:surface
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./grid.png@
                float2 inputs:st.connect = </World/Looks/Textured/Uv.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:r
                float3 outputs:rgb
            }

            def Shader "Uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                string inputs:varname = "perfuv"
                float2 outputs:result
            }
        }

        def Material "PurposePreview"
        {
            token outputs:surface.connect = </World/Looks/PurposePreview/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.9, 0.5, 0.1)
                token outputs:surface
            }
        }

        def Material "PurposeFull"
        {
            token outputs:surface.connect = </World/Looks/PurposeFull/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.1, 0.9)
                token outputs:surface
            }
        }

        def Material "PurposeAll"
        {
            token outputs:surface.connect = </World/Looks/PurposeAll/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                token outputs:surface
            }
        }
    }

    def Xform "SharedPrototype"
    {
        def Xform "KitA" (
            instanceable = true
            references = </Prototypes/Kit>
        )
        {
        }

        def Xform "KitB" (
            instanceable = true
            references = </Prototypes/Kit>
        )
        {
            double3 xformOp:translate = (3, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Xform "KitC" (
            instanceable = true
            references = </Prototypes/Kit>
        )
        {
            double xformOp:rotateZ = 90
            float3 xformOp:scale = (2, 1, 0.5)
            double3 xformOp:translate = (6, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ", "xformOp:scale"]
        }
    }

    def Xform "EqualContent"
    {
        def Mesh "MeshA"
        {
            float3[] extent = [(0, 0, 0), (1, 1, 0)]
