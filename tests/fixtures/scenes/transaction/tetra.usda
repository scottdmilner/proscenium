#usda 1.0
# The transaction fixtures' one mesh (see root.usda): a closed tetrahedron at the origin whose authored
# extent is its points' bounds, (0, 0, 0) to (1, 1, 1), so every placeholder's local bounds are known.
(
    defaultPrim = "Tetra"
)

def Mesh "Tetra"
{
    float3[] extent = [(0, 0, 0), (1, 1, 1)]
    int[] faceVertexCounts = [3, 3, 3, 3]
    int[] faceVertexIndices = [0, 2, 1, 0, 1, 3, 0, 3, 2, 1, 2, 3]
    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0), (0, 0, 1)]
}
