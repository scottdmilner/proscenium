#usda 1.0
# Malformed node definitions, one problem each, for the cook's loader: each type is named for its problem. None has an
# implementation, which the loader reports too, but CreatePrim and LayerFromFile, which disagree with their
# implementations' roles: CreatePrim has no Prim output, and LayerFromFile has an Editable Layer input.

def "NotAClass"
{
    int node:version = 1
}

class "NoVersion"
{
    opaque outputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
}

class "UnknownSocketKind"
{
    int node:version = 1
    opaque inputs:layer (
        customData = {
            string socket = "Mesh"
        }
    )
}

class "LayerNotOpaque"
{
    int node:version = 1
    string inputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
}

class "OpaqueWithoutSocket"
{
    int node:version = 1
    opaque inputs:layer
}

class "AttributeOutsideNamespaces"
{
    int node:version = 1
    float size
}

class "MultiInputOutput"
{
    int node:version = 1
    opaque outputs:layer (
        customData = {
            bool multiInput = 1
            string socket = "Layer"
        }
    )
}

class "PassThroughToNothing"
{
    int node:version = 1
    opaque outputs:editableLayer (
        customData = {
            string mutePassThrough = "inputs:editableLayer"
            string socket = "EditableLayer"
        }
    )
}

class "PassThroughOtherKind"
{
    int node:version = 1
    opaque inputs:layer (
        customData = {
            string socket = "Layer"
        }
    )
    opaque outputs:editableLayer (
        customData = {
            string mutePassThrough = "inputs:layer"
            string socket = "EditableLayer"
        }
    )
}

class "MultiInputPrim"
{
    int node:version = 1
    string inputs:prims (
        customData = {
            bool multiInput = 1
            string socket = "Prims"
        }
    )
}

class "OptionalInput"
{
    int node:version = 1
    float inputs:size (
        customData = {
            bool optional = 1
        }
    )
}

class "TwoEditableLayerInputs"
{
    int node:version = 1
    opaque inputs:layer (
        customData = {
            string socket = "EditableLayer"
        }
    )
    opaque inputs:other (
        customData = {
            string socket = "EditableLayer"
        }
    )
}

class "ZoneUnknownEdge" (
    customData = {
        string zone = "middle"
    }
)
{
    int node:version = 1
}

class "ZoneWithoutPartner" (
    customData = {
        string zone = "begin"
    }
)
{
    int node:version = 1
}

class "PartnerWithoutZone" (
    customData = {
        string zonePartner = "ZonePairEnd"
    }
)
{
    int node:version = 1
}

class "ZonePartnerMissing" (
    customData = {
        string zone = "begin"
        string zonePartner = "Nowhere"
    }
)
{
    int node:version = 1
}

class "ZonePartnerSameEdge" (
    customData = {
        string zone = "begin"
        string zonePartner = "ZonePartnerSameEdgeToo"
    }
)
{
    int node:version = 1
}

class "ZonePartnerSameEdgeToo" (
    customData = {
        string zone = "begin"
        string zonePartner = "ZonePartnerSameEdge"
    }
)
{
    int node:version = 1
}

class "EditableLayerOutputTaken"
{
    int node:version = 1
    opaque outputs:layer (
        customData = {
            string socket = "Layer"
            bool takesEditableLayer = 1
        }
    )
}

class "ClosedMenuWithoutItems"
{
    int node:version = 1
    token props:mode = "a" (
        customData = {
            bool closedMenu = 1
        }
    )
}

class "CreatePrim"
{
    int node:version = 1
    opaque inputs:editableLayer (
        customData = {
            string socket = "EditableLayer"
        }
    )
    opaque outputs:editableLayer (
        customData = {
            string socket = "EditableLayer"
        }
    )
}

class "LayerFromFile"
{
    int node:version = 1
    opaque inputs:editableLayer (
        customData = {
            string socket = "EditableLayer"
        }
    )
}
