#usda 1.0
# F-KIND-HIERARCHY (tests/fixtures/interaction.py): a model-kind hierarchy for selection levels and
# subtree expansion. Only Chair, Lamp, Table, and Debris author transforms; /World, Props, and Geom
# author nothing but kind, so nothing Hydra needs to keep them. Kind cases: a group level
# reaches the assembly /World from Table (assembly derives from group), a subcomponent level
# reaches Geom from Seat but nothing from Legs, and /Debris/Rock sits under no model at all.
# Kinds outside a valid model hierarchy (UsdPrim::IsModel false) still match a kind level: Vase is a
# component inside the component Table, and Crate a component under Debris, which has no kind.
# Every mesh is one triangle, so any display representation shows it.
(
    defaultPrim = "World"
)

def Xform "World" (
    kind = "assembly"
)
{
    def Xform "Props" (
        kind = "group"
    )
    {
        def Xform "Chair" (
            kind = "component"
        )
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Xform "Geom" (
                kind = "subcomponent"
            )
            {
                def Mesh "Seat"
                {
                    float3[] extent = [(0, 0, 0), (1, 1, 0)]
                    int[] faceVertexCounts = [3]
                    int[] faceVertexIndices = [0, 1, 2]
                    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                }

                def Mesh "Back"
                {
                    float3[] extent = [(0, 0, 0), (1, 1, 0)]
                    int[] faceVertexCounts = [3]
                    int[] faceVertexIndices = [0, 1, 2]
                    point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
                }
            }

            def Mesh "Legs"
            {
                float3[] extent = [(0, 0, 0), (1, 1, 0)]
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
        }

        def Xform "Lamp" (
            kind = "component"
        )
        {
            double3 xformOp:translate = (2, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Mesh "Shade"
            {
                float3[] extent = [(0, 0, 0), (1, 1, 0)]
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
        }
    }

    def Xform "Table" (
        kind = "component"
    )
    {
        double3 xformOp:translate = (4, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Top"
        {
            float3[] extent = [(0, 0, 0), (1, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }

        def Xform "Vase" (
            kind = "component"
        )
        {
            def Mesh "Body"
            {
                float3[] extent = [(0, 0, 0), (1, 1, 0)]
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
            }
        }
    }
}

def Xform "Debris"
{
    double3 xformOp:translate = (0, 4, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]

    def Mesh "Rock"
    {
        float3[] extent = [(0, 0, 0), (1, 1, 0)]
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
    }

    def Xform "Crate" (
        kind = "component"
    )
    {
        def Mesh "Box"
        {
            float3[] extent = [(0, 0, 0), (1, 1, 0)]
            int[] faceVertexCounts = [3]
            int[] faceVertexIndices = [0, 1, 2]
            point3f[] points = [(0, 0, 0), (1, 0, 0), (0, 1, 0)]
        }
    }
}
